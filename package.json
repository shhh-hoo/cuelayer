{
  "name": "cuelayer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:cuecaption-policy": "node --experimental-strip-types scripts/generate-cuecaption-policy.ts",
    "check:cuecaption-policy": "node --experimental-strip-types scripts/generate-cuecaption-policy.ts --check",
    "benchmark:planner": "node --experimental-strip-types scripts/benchmark-live-planner.ts",
    "predev": "npm run check:cuecaption-policy",
    "dev": "vite",
    "prebuild": "npm run check:cuecaption-policy",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm run check:cuecaption-policy",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run check:cuecaption-policy",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@speechmatics/auth": "^0.1.0",
    "@speechmatics/browser-audio-input": "^2.0.4",
    "@speechmatics/browser-audio-input-react": "^2.0.4",
    "@speechmatics/real-time-client": "^8.5.1",
    "@speechmatics/real-time-client-react": "^3.5.1",
    "katex": "0.18.4",
    "motion": "13.1.1",
    "openai": "^7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
