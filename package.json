{
  "name": "cuelayer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:semantics:freeze": "node --experimental-strip-types scripts/build-semantics-corpus.ts",
    "eval:semantics:validate": "node --experimental-strip-types scripts/evaluate-semantics.ts --validate",
    "eval:semantics:live": "node --experimental-strip-types scripts/evaluate-semantics.ts --live",
    "preview": "vite preview"
  },
  "dependencies": {
    "@speechmatics/auth": "^0.1.0",
    "@speechmatics/browser-audio-input": "^2.0.4",
    "@speechmatics/browser-audio-input-react": "^2.0.4",
    "@speechmatics/real-time-client": "^8.5.1",
    "@speechmatics/real-time-client-react": "^3.5.1",
    "katex": "0.18.4",
    "openai": "^7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
