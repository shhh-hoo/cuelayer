{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/planner/decision.ts": {
      "includeFiles": "server/planner/**"
    },
    "api/teaching/interpretation.ts": {
      "includeFiles": "server/teaching/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
