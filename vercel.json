{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/cuelayer-v2-incremental-semantic-frontier": false,
      "fix/cuelayer-v2-real-model-contract": false,
      "fix/cuelayer-v2-text-delivery": false
    }
  },
  "functions": {
    "api/teaching/interpretation.ts": {
      "includeFiles": "server/teaching/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
