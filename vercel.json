{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/cuelayer-v2-incremental-semantic-frontier": false,
      "chore/cuelayer-v2-evaluation-design": false,
      "fix/cuelayer-v2-stage-oracle-v2": false,
      "feat/v2-evaluation-execution-53": false,
      "feat/v2-semantic-qualification-58": false
    }
  },
  "functions": {
    "api/teaching/interpretation.ts": {
      "includeFiles": "server/teaching/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
