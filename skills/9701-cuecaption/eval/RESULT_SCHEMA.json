{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "9701 CueCaption LLM semantic evaluation result",
  "type": "object",
  "required": ["runId", "modelLabel", "mode", "results"],
  "properties": {
    "runId": { "type": "string", "description": "Human-assigned evaluation run identifier." },
    "modelLabel": { "type": "string", "description": "Model/version label supplied by evaluator." },
    "mode": { "type": "string", "enum": ["baseline", "skill"] },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "canonicalText", "decisions", "protectedPhrases", "symbolicRewrites", "chemistryTokens", "renderHints", "warnings"],
        "properties": {
          "caseId": { "type": "string" },
          "canonicalText": { "type": "string" },
          "decisions": { "type": "array", "items": { "type": "object", "required": ["label", "target", "reason"], "properties": { "label": { "type": "string", "enum": ["CANONICALIZE", "FX_ONLY", "PRESERVE", "BLOCK_INFERENCE"] }, "target": { "type": "string" }, "reason": { "type": "string" } } } },
          "protectedPhrases": { "type": "array", "items": { "type": "object", "required": ["text", "reason"], "properties": { "text": { "type": "string" }, "reason": { "type": "string" } } } },
          "symbolicRewrites": { "type": "array", "items": { "type": "object", "required": ["plainText", "displayText", "reason"], "properties": { "plainText": { "type": "string" }, "displayText": { "type": "string" }, "reason": { "type": "string" } } } },
          "chemistryTokens": { "type": "array", "items": { "type": "object", "required": ["text", "kind"], "properties": { "text": { "type": "string" }, "kind": { "type": "string", "enum": ["substance", "ion", "formula", "symbol", "quantity", "unit", "process", "concept", "condition", "observation"] } } } },
          "renderHints": { "type": "array", "items": { "type": "object", "required": ["target", "kind"], "properties": { "target": { "type": "string" }, "kind": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 48, "description": "Controlled kebab-case non-semantic hint. Prefer existing vocabulary; introduce one only when no existing hint has the same function." } } } },
          "warnings": { "type": "array", "items": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "enum": ["ASR_AMBIGUITY", "MISSING_STRUCTURE", "MISSING_REFERENCE", "MISSING_REACTION_FACT", "POSSIBLE_TEACHER_ERROR", "CONTEXT_CONFLICT"] }, "message": { "type": "string" } } } },
          "review": {
            "type": "object",
            "required": ["verdict", "findingClass", "findings"],
            "properties": {
              "verdict": { "type": "string", "enum": ["ACCEPT", "REVISE", "REJECT"] },
              "findingClass": { "type": "string", "enum": ["none", "skill_gap", "model_execution_failure", "source_ambiguity"] },
              "findings": { "type": "array", "items": { "type": "object", "required": ["severity", "dimension", "note"], "properties": { "severity": { "type": "string", "enum": ["Critical", "Major", "Minor"] }, "dimension": { "type": "string" }, "note": { "type": "string" } } } }
            }
          }
        }
      }
    }
  }
}
