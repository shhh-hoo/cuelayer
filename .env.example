# Server only. Never prefix this with VITE_ or expose it in browser source.
SPEECHMATICS_API_KEY=
# Deployment-only private durable trace store. Local development uses .cuelayer/traces.
BLOB_READ_WRITE_TOKEN=

# Server only. DeepSeek is called through its OpenAI-compatible Responses API.
DEEPSEEK_API_KEY=
# Optional. Defaults to deepseek-v4-flash.
DEEPSEEK_MODEL=
